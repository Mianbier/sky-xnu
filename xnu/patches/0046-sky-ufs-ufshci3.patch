+/*
+ * UTRD DWORD 0, from Linux drivers/scsi/ufs/ufshci.h:
+ *
+ *     dword_0 = data_direction | (command_type << 28) | interrupt
+ *
+ * The command type is version dependent. UTP_CMD_TYPE_UFS_STORAGE (1) is only
+ * valid on UFSHCI 2.0; from 2.1 on, SCSI commands use UTP_CMD_TYPE_SCSI (0)
+ * and device management (queries) uses UTP_CMD_TYPE_DEV_MANAGE (2). sky
+ * reports 0x300, so sending 1 for everything is wrong.
+ */
+#define UTRD_CT_SCSI        0x00000000u
+#define UTRD_CT_DEV_MANAGE  0x20000000u
+#define UTRD_INT            0x01000000u
+#define UTRD_DD_TO_DEV      0x02000000u
+#define UTRD_DD_TO_HOST     0x04000000u
+
 #define HCS_DP          (1u << 0)
 #define HCS_UTRLRDY     (1u << 1)
 #define HCS_UCRDY       (1u << 3)
@@ -148,8 +164,13 @@
