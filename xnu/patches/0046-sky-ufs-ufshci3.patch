+/* ------------------------------------------------------------------ UIC ---- *
+ *
+ * UniPro link control. UIC commands do not go through the transfer request
+ * list, which is why they can succeed while every SCSI command fails.
+ */
+
+#define REG_UICCMD      0x90
+#define REG_UICARG1     0x94
+#define REG_UICARG2     0x98
+#define REG_UICARG3     0x9c
+
+#define UIC_OP_DME_RESET         0x14
+#define UIC_OP_DME_ENABLE        0x12
+#define UIC_OP_DME_LINKSTARTUP   0x16
+#define UIC_OP_DME_HIBERNATE_EXIT 0x18
+
+/*
+ * Issue one UIC command and return its result code (0 = success), or -1 if the
+ * command never completed.
+ */
+static int
+ufs_uic(uint32_t opcode)
+{
+	uint32_t spins = 0;
+
+	ufs_wr(REG_UICARG1, 0);
+	ufs_wr(REG_UICARG2, 0);
+	ufs_wr(REG_UICARG3, 0);
+	ufs_wr(REG_UICCMD, opcode << 16);
+
+	while (ufs_rd(REG_UICCMD) & 0x80000000u) {
+		if (++spins > 100000000u) {
+			return -1;
+		}
+	}
+	return (int)(ufs_rd(REG_UICCMD) & 0xffffu);
+}
+
+/*
+ * Bring the link up and let the device finish its own initialisation. Both
+ * steps are cheap and harmless when the link is already healthy.
+ */
+static void
+ufs_wake_link(void)
+{
+	int hibernate = ufs_uic(UIC_OP_DME_HIBERNATE_EXIT);
+	int startup = ufs_uic(UIC_OP_DME_LINKSTARTUP);
+
+	printf("SKY UFS: hibernate_exit %d linkstartup %d\n", hibernate, startup);
+
+	/* A link start invalidates the request list: point it at ours again. */
+	ufs_wr(REG_UTRLRSR, 0);
+	uint64_t list = su.dma_pa + DMA_UTRL;
+	ufs_wr(REG_UTRLBA, (uint32_t)list);
+	ufs_wr(REG_UTRLBAU, (uint32_t)(list >> 32));
+	ufs_wr(REG_UTRLRSR, 1);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+}
+
+/* ----------------------------------------------------------- UFS query ---- *
+ *
+ * Queries read the Device and Unit descriptors. bLUEnable in the Unit
+ * Descriptor is what decides whether a LUN will answer SCSI commands at all,
+ * so this is how we find out why TEST UNIT READY keeps coming back NOT READY.
+ *
+ * Layout, per Linux's utp_upiu_query (sizeof == 20, starting at byte 12):
+ *
+ *     +0 opcode  +1 idn  +2 index  +3 selector
+ *     +4..+5 reserved   +6..+7 length (big endian)
+ *     +8..+11 value     +12..+19 reserved
+ */
+
+#define UPIU_TRANSACTION_QUERY_REQ 0x16
+#define UPIU_QUERY_FUNC_READ       0x01
+#define QUERY_OP_READ_FLAG         0x05
+#define QUERY_OP_READ_DESC         0x01
+#define QUERY_FLAG_IDN_FDEVICEINIT 0x01
+
+/*
+ * One query request in slot 0. Returns 0 when the device reports success,
+ * otherwise the UPIU stage code. For READ_DESC the descriptor is written to
+ * out[] and its length to *got.
+ */
+static int
+ufs_query(uint8_t opcode, uint8_t idn, uint8_t index, uint8_t selector,
+    uint8_t value, uint8_t *out, unsigned int len, unsigned int *got)
+{
+	struct utrd *utrd = (struct utrd *)(su.dma + DMA_UTRL);
+	struct ucd *ucd = (struct ucd *)(su.dma + DMA_UCD);
+	uint64_t ucd_pa = su.dma_pa + DMA_UCD;
+
+	if (got) {
+		*got = 0;
+	}
+	if (len > 255) {
+		len = 255;
+	}
+	bzero(utrd, sizeof(*utrd));
+	bzero(ucd, sizeof(*ucd));
+
+	/* UPIU header is 12 bytes; READ_DESC carries no inline data segment. */
+	ucd->cmd[0] = UPIU_TRANSACTION_QUERY_REQ;
+	ucd->cmd[1] = 0x00;             /* no data direction (DMA_NONE) */
+	ucd->cmd[2] = 0x00;             /* LUN */
+	ucd->cmd[3] = ++su.tag;
+	ucd->cmd[5] = UPIU_QUERY_FUNC_READ;
+	ucd->cmd[10] = 0x00;            /* dword_2 = 0 for READ_DESC */
+	ucd->cmd[11] = 0x00;
+
+	ucd->cmd[12] = opcode;
+	ucd->cmd[13] = idn;
+	ucd->cmd[14] = index;
+	ucd->cmd[15] = selector;
+	ucd->cmd[18] = (uint8_t)(len >> 8);
+	ucd->cmd[19] = (uint8_t)len;
+	ucd->cmd[24] = value;           /* value is a big-endian u32 at +8 */
+
+	/* Device management, no data direction, interrupt, no PRDT. */
+	utrd->dw0 = UTRD_CT_DEV_MANAGE | UTRD_INT;
+	utrd->dw2 = 0x0f;
+	utrd->ucdba = (uint32_t)ucd_pa;
+	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
+	utrd->resp = (512u / 4) << 16 | (512u / 4);
+
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD, sizeof(*ucd));
+	__builtin_arm_dsb(0xf);
+
+	ufs_wr(REG_UTRLDBR, 1);
+	uint32_t spins = 0;
+	while (ufs_rd(REG_UTRLDBR) & 1) {
+		if (++spins > 100000000u) {
+			ufs_wr(REG_UTRLCLR, ~1u);
+			return 1;
+		}
+	}
+	__builtin_arm_dsb(0xf);
+
+	if (utrd->dw2 & 0xff) {
+		return 2;
+	}
+	if (ucd->resp[0] != 0x36) {
+		return 3;
+	}
+	if (ucd->resp[6] != 0) {
+		printf("SKY UFS: query opcode 0x%x idn 0x%x failed: 0x%x\n",
+		    opcode, idn, ucd->resp[6]);
+		return 4;
+	}
+	if (opcode == QUERY_OP_READ_DESC && out) {
+		/* The descriptor arrives inline at response offset 32. */
+		unsigned int n = (unsigned int)
+		    (((ucd->resp[8] << 24) | (ucd->resp[9] << 16) |
+		    (ucd->resp[10] << 8) | ucd->resp[11]) & 0xffffu);
+		if (n > len) {
+			n = len;
+		}
+		memcpy(out, &ucd->resp[32], n);
+		if (got) {
+			*got = n;
+		}
+	}
+	return 0;
+}
+
+/*
+ * Report what the device thinks it has. Purely diagnostic; it does not change
+ * any state.
+ */
+static void
+ufs_report_descriptors(void)
+{
+	uint8_t d[64] = { 0 };
+	unsigned int got = 0;
+	int error;
+
+	error = ufs_query(QUERY_OP_READ_DESC, 0x00, 0, 0, 0, d, 32, &got);
+	printf("SKY UFS: device descriptor: stage %d got %u\n", error, got);
+	if (!error && got >= 4) {
+		printf("SKY UFS:   bLength %u bNumberLU %u bNumberWLU %u\n",
+		    d[0], d[3], d[4]);
+	}
+
+	bzero(d, sizeof(d));
+	error = ufs_query(QUERY_OP_READ_DESC, 0x02, 0, 0, 0, d, 32, &got);
+	printf("SKY UFS: LU0 descriptor: stage %d got %u\n", error, got);
+	if (!error && got >= 4) {
+		printf("SKY UFS:   bLUEnable %u bBootLunID %u\n", d[1], d[2]);
+	}
 }
 
