+	utrd->dw0 = UTRD_CT_SCSI | UTRD_INT |
+	    (len ? (write ? UTRD_DD_TO_DEV : UTRD_DD_TO_HOST) : 0);
 	utrd->dw2 = 0x0f;                       /* OCS invalid until updated */
