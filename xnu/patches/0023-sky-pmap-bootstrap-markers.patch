diff --git a/osfmk/arm64/sky_early.c b/osfmk/arm64/sky_early.c
--- a/osfmk/arm64/sky_early.c
+++ b/osfmk/arm64/sky_early.c
@@ -89,13 +89,17 @@
 void
 sky_early_mark(unsigned int stage, const char *label)
 {
-	if (early_disabled || stage > 20) {
+	if (early_disabled || stage > 40) {
 		return;
 	}
-	uint32_t color = 0xff00ff00u | ((stage & 7u) * 32u << 16);
-	for (unsigned int y = EARLY_HEIGHT - 32; y < EARLY_HEIGHT; y++) {
-		for (unsigned int x = stage * 48; x < (stage + 1) * 48; x++) {
-			EARLY_FB[y * EARLY_STRIDE + x] = color;
+	/* The band is stage*48 px wide; past stage 20 it would run off the
+	 * 1080 px line and scribble into the next row. Text still prints. */
+	if (stage <= 20) {
+		uint32_t color = 0xff00ff00u | ((stage & 7u) * 32u << 16);
+		for (unsigned int y = EARLY_HEIGHT - 32; y < EARLY_HEIGHT; y++) {
+			for (unsigned int x = stage * 48; x < (stage + 1) * 48; x++) {
+				EARLY_FB[y * EARLY_STRIDE + x] = color;
+			}
 		}
 	}
 	__asm__ volatile("dsb sy" ::: "memory");
