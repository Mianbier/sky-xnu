diff --git a/osfmk/arm64/ppl/sart.h b/osfmk/arm64/ppl/sart.h
new file mode 100644
index 0000000..a8cd7b6
--- /dev/null
+++ b/osfmk/arm64/ppl/sart.h
@@ -0,0 +1,13 @@
+/*
+ * sky: Apple's SART (IOMMU for NVMe/ANS) header is not in the open
+ * source drop. There is no SART on Qualcomm hardware; bootstrap is a no-op.
+ */
+#ifndef _ARM64_PPL_SART_H_
+#define _ARM64_PPL_SART_H_
+
+static inline void
+sart_bootstrap(void)
+{
+}
+
+#endif /* _ARM64_PPL_SART_H_ */
